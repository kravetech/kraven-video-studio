{
  "name": "kraven-video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "AI-assisted video production toolkit. You shoot. AI edits. You approve.",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "node scripts/start-studio.mjs",
    "sync:ds": "node scripts/sync-design-system.mjs",
    "broll": "node scripts/render-broll.mjs",
    "broll:examples": "node scripts/render-broll.mjs examples/broll-cues.example.json out/examples",
    "broll:examples:169": "node scripts/render-broll.mjs examples/broll-cues-169.example.json out/examples-169",
    "preflight": "node scripts/preflight.mjs",
    "captions:from-whisper": "node scripts/whisper-to-captions.mjs",
    "captions:show": "node scripts/transcript-for-review.mjs",
    "captions:approve": "node scripts/mark-transcript-reviewed.mjs",
    "captions:approve-sync": "node scripts/mark-sync-reviewed.mjs",
    "captions:srt": "node scripts/captions-to-srt.mjs",
    "render:final": "node scripts/render-final.mjs",
    "cover": "node scripts/make-cover.mjs",
    "cover:frames": "node scripts/cover-frames.mjs",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade",
    "post": "node scripts/make-post.mjs",
    "validate": "node scripts/validate-package.mjs",
    "release": "node scripts/release.mjs",
    "transcribe": "node scripts/transcribe.mjs",
    "test:installer": "node tests/run.mjs installer",
    "test": "node tests/run.mjs unit",
    "thumbnail": "node scripts/make-cover.mjs --thumbnail",
    "check": "pnpm version:check && pnpm typecheck && pnpm test",
    "demo": "node scripts/create-demo.mjs",
    "sfx": "node scripts/make-sfx.mjs",
    "test:media": "node tests/run.mjs media --enhancements",
    "check:cuts": "node scripts/check-cut-edges.mjs",
    "takes:review": "node scripts/review-takes.mjs",
    "pacing:review": "node scripts/review-pacing.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs --set",
    "test:studio": "node tests/run.mjs studio",
    "test:storage": "node tests/run.mjs storage",
    "test:storage:installer": "node tests/run.mjs storage-installer",
    "storage:status": "node scripts/storage.mjs",
    "storage:clean": "node scripts/storage.mjs --clean"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.538",
    "@remotion/captions": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@remotion/layout-utils": "4.0.538",
    "@remotion/media-utils": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@remotion/shapes": "4.0.538",
    "@remotion/tailwind-v4": "4.0.538",
    "@remotion/zod-types": "4.0.538",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538",
    "tailwindcss": "4.3.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "displayName": "Kraven Video Studio",
  "tagline": "You shoot. AI edits. You approve.",
  "homepage": "https://kraven.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kravetech/kraven-video-studio.git"
  },
  "bugs": {
    "url": "https://github.com/kravetech/kraven-video-studio/issues"
  }
}
